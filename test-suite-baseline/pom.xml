<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- groupId mined from docs/reference/automation-poc/pom.xml:8 (ADR-0041 D7) -->
    <groupId>com.automation</groupId>
    <artifactId>test-suite-baseline</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Test Suite Baseline (ADR-0037 tracked tier)</name>

    <properties>
        <!-- ADR-0041 D1: the stricter single-property form, not the POC's source/target pair -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- ADR-0041 D2: BOM-managed, not hand-pinned per-artifact like the POC -->
        <junit.bom.version>5.10.3</junit.bom.version>
        <cucumber.bom.version>7.18.0</cucumber.bom.version>

        <!-- ADR-0041 D5: explicit pin, verified against docs/reference/automation-poc/pom.xml:20 -->
        <selenium.version>4.25.0</selenium.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.cucumber</groupId>
                <artifactId>cucumber-bom</artifactId>
                <version>${cucumber.bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- JUnit Jupiter: assertions only (ADR-0041 D4). Version managed by junit-bom. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JUnit Platform Suite: @Suite / @IncludeEngines / @SelectClasspathResource (ADR-0041 D3) -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JUnit Platform Launcher: required by Surefire to discover the suite -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Cucumber core + Java glue -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Cucumber JUnit Platform engine: bridges Cucumber to the JUnit Platform -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Selenium WebDriver. No WebDriverManager (ADR-0041 D5): Selenium Manager
             (bundled since 4.6) resolves driver binaries instead. -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- This module is test-only (ADR-0037 Path A: everything under src/test/java,
             no src/main/java). jacoco-maven-plugin's own report goal is hardcoded to
             check project.build.outputDirectory (main classes) for its own "is there
             anything to report on" guard, which never exists here and otherwise makes
             it silently skip, logging "Skipping JaCoCo execution due to missing
             classes directory". Pointing outputDirectory at the SAME place
             testOutputDirectory already resolves to is the standard workaround for a
             test-only module; it changes nothing else, since no other plugin here
             reads outputDirectory (there is no main compile step for it to affect). -->
        <outputDirectory>${project.build.directory}/test-classes</outputDirectory>
        <plugins>
            <!-- Picks up maven.compiler.release automatically; no explicit <configuration>
                 needed for the release property itself. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!-- JUnit Platform provider is picked up automatically once junit-platform-suite
                 is on the test classpath (Surefire 3.x). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <includes>
                        <include>**/runners/RunCucumberTest.java</include>
                    </includes>
                </configuration>
            </plugin>

            <!-- JaCoCo (ADR-0047 D5/D11, latent #5/item #39): standard, minimal setup.
                 prepare-agent instruments the test JVM; report emits the XML CP7's Sonar
                 scan reads via sonar.coverage.jacoco.xmlReportPaths (LiveSonarQualityGateAdapter).
                 No excludes, includes, or thresholds added; coverage stays report-only
                 (D5); this plugin only makes the number real, it does not gate anything. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
